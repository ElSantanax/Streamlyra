# Configuración del Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de Datos
DATABASE_URL=postgres://user:password@localhost:5432/streamlyra_db

# Seguridad (CRÍTICO: Cambiar en producción)
# Generar con: openssl rand -base64 32
JWT_SECRET=change_me_to_a_secure_random_string

# Encriptación de Base de Datos (Tokens OAuth)
# Debe ser un string hex de 64 caracteres (32 bytes)
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Integración Twitch
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:5173/auth/twitch/callback

# Integración YouTube
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:5173/auth/youtube/callback

# Integración Kick
KICK_CLIENT_ID=your_kick_client_id
KICK_CLIENT_SECRET=your_kick_client_secret
KICK_REDIRECT_URI=http://localhost:5173/auth/kick/callback
# Configurar a 'false' en producción por seguridad
KICK_WEBHOOK_SKIP_SIGNATURE=false 
